NODE_ENV=development
PORT=5001
# note: macOS AirPlay Receiver occupies :5000, so this API defaults to :5001

# Database — local mongod, or a MongoDB Atlas connection string.
# Always include the database name in the path (…mongodb.net/gia_educare),
# otherwise mongoose connects to `test`.
MONGODB_URI=mongodb://127.0.0.1:27017/gia_educare

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Refresh-cookie flags.
# The admin panel is usually deployed on a different domain than this API, which
# makes the cookie cross-site: that needs SameSite=None and Secure=true (HTTPS).
# Only set 'lax'/'false' if the API and admin share one origin.
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# CORS — comma separated origins allowed to call this API.
# Use * to allow any origin (the API reflects the caller's origin so that
# cookie-based admin auth keeps working). Prefer an explicit list in production.
CORS_ORIGINS=*

# Seeded super admin (used by `npm run seed`)
SEED_ADMIN_NAME=GIA Admin
SEED_ADMIN_EMAIL=admin@giaeducare.com
SEED_ADMIN_PASSWORD=Admin@12345

# Public base url of this API (used to build absolute upload urls)
PUBLIC_URL=http://localhost:5001

# Public URLs of the two frontends — used for links inside emails.
SITE_URL=http://localhost:5183
ADMIN_URL=http://localhost:5174

# Email notifications (new-lead alerts, student confirmations, new accounts).
# Any SMTP provider works. Leave SMTP_HOST empty to log emails instead of sending.
#   Gmail:    smtp.gmail.com / 465 / SMTP_SECURE=true  (use an App Password)
#   Zoho:     smtp.zoho.in   / 465 / SMTP_SECURE=true
#   SendGrid: smtp.sendgrid.net / 587 / SMTP_USER=apikey
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=GIA Educare <no-reply@giaeducare.com>

# Signs the arithmetic captcha on public forms and admin login.
# Optional — falls back to JWT_ACCESS_SECRET.
CAPTCHA_SECRET=

# Encrypts secrets saved from the admin panel, such as the SMTP password.
# Optional — falls back to JWT_ACCESS_SECRET. If you change it, re-enter the SMTP password in the admin.
SETTINGS_SECRET=
